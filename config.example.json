{
  "database_path": "data/mappings.sqlite3",
  "search_limit": 10,
  "managed_playlist_prefix": "Spotify Daily Mix",
  "matching": {
    "auto_accept_threshold": 90,
    "review_threshold": 75,
    "weight_title": 0.45,
    "weight_artist": 0.35,
    "weight_album": 0.1,
    "weight_duration": 0.1,
    "duration_tolerance_s": 3,
    "duration_zero_s": 15,
    "duration_mismatch_s": 30,
    "duration_mismatch_penalty": 15,
    "qualifier_mismatch_penalty": 20,
    "flag_penalties": {
      "live": 30,
      "remix": 30,
      "acoustic": 30,
      "demo": 30,
      "instrumental": 30,
      "radio_edit": 15,
      "remaster": 2
    }
  }
}
